@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Measure whether a time-compressed spin policy can make a stable corner turn."""
+
+from __future__ import annotations
+
+import argparse
+import itertools
+import math
+from pathlib import Path
+
+import mujoco
+import numpy as np
+
+from infer_policy import DEFAULT_POSE, PolicyInference
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SCENE = ROOT / "src/mjlab_microduck/robot/microduck/scene_roller_showcase.xml"
+ROLLER = ROOT / "policies/upstream/roller.onnx"
+SPIN = ROOT / "policies/trained/spin_model_500.onnx"
+
+
+def yaw_from_quat(quat: np.ndarray) -> float:
+    qw, qx, qy, qz = quat
+    return math.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--periods",
+        type=float,
+        nargs="+",
+        default=(0.8, 1.0, 1.2, 1.4, 1.6, 1.8, 2.0),
+    )
+    parser.add_argument(
+        "--runup-commands", type=float, nargs="+", default=(0.0,),
+        help="Roller forward commands applied before the turn.",
+    )
+    parser.add_argument(
+        "--runup-seconds", type=float, nargs="+", default=(4.0,),
+        help="Run-up durations after a 0.8 s settle and 0.5 s command ramp.",
+    )
+    parser.add_argument(
+        "--blend-seconds", type=float, nargs="+", default=(0.0,),
+        help="Action cross-fade durations from roller to spin policy.",
+    )
+    parser.add_argument(
+        "--spin-weights", type=float, nargs="+", default=(1.0,),
+        help="Maximum spin-policy share; the roller policy remains active below 1.0.",
+    )
+    args = parser.parse_args()
+
+    model = mujoco.MjModel.from_xml_path(str(SCENE))
+    model.opt.timestep = 0.005
+    data = mujoco.MjData(model)
+    for joint_id in range(model.njnt):
+        name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, joint_id)
+        if name and name.startswith("passive_"):
+            model.dof_frictionloss[model.jnt_dofadr[joint_id]] = 0.003
+
+    policy = PolicyInference(
+        model,
+        data,
+        walking_onnx_path=str(ROLLER),
+        ground_pick_onnx_path=str(SPIN),
+        ground_pick_period=4.25,
+        use_projected_gravity=True,
+        new_cmd_obs=True,
+    )
+    freejoint_id = mujoco.mj_name2id(
+        model, mujoco.mjtObj.mjOBJ_JOINT, "trunk_base_freejoint"
+    )
+    qpos_adr = int(model.jnt_qposadr[freejoint_id])
+    qvel_adr = int(model.jnt_dofadr[freejoint_id])
+    control_dt = 0.02
+    decimation = 4
+
+    print(
+        "runup_cmd,runup_s,entry_speed_mps,blend_s,spin_weight,period_s,active_s,yaw_deg,"
+        "turn_path_m,min_speed_mps,end_speed_mps,final_rate_radps,drift_m,min_upright"
+    )
+    for runup_command, runup_s, blend_s, spin_weight, period in itertools.product(
+        args.runup_commands,
+        args.runup_seconds,
+        args.blend_seconds,
+        args.spin_weights,
+        args.periods,
+    ):
+        mujoco.mj_resetData(model, data)
+        data.qpos[qpos_adr:qpos_adr + 7] = (-1.8, -0.65, 0.1385, 1.0, 0.0, 0.0, 0.0)
+        for index, qpos_index in enumerate(policy.joint_qpos_indices):
+            data.qpos[qpos_index] = DEFAULT_POSE[index]
+        data.ctrl[:] = DEFAULT_POSE[:model.nu]
+        policy.last_action[:] = 0.0
+        policy.vel_cmd[:] = 0.0
+        policy.head_offset[:] = 0.0
+        policy.current_policy = "walking"
+        policy.ort_session = policy.walking_session
+        policy.ground_pick_mode = False
+        policy._update_command()
+        mujoco.mj_forward(model, data)
+
+        previous_yaw = yaw_from_quat(data.qpos[qpos_adr + 3:qpos_adr + 7])
+        unwrapped_yaw = previous_yaw
+        min_upright = 1.0
+
+        def step_once() -> None:
+            nonlocal previous_yaw, unwrapped_yaw, min_upright
+            action = policy.infer()
+            policy.apply_action(action)
+            for _ in range(decimation):
+                mujoco.mj_step(model, data)
+            yaw = yaw_from_quat(data.qpos[qpos_adr + 3:qpos_adr + 7])
+            unwrapped_yaw += math.atan2(
+                math.sin(yaw - previous_yaw), math.cos(yaw - previous_yaw)
+            )
+            previous_yaw = yaw
+            min_upright = min(min_upright, float(-policy.get_projected_gravity()[2]))
+
+        for _ in range(round(0.8 / control_dt)):
+            step_once()
+
+        for runup_step in range(round(runup_s / control_dt)):
+            elapsed = runup_step * control_dt
+            ramp = min(1.0, max(0.0, elapsed / 0.5))
+            ramp = ramp * ramp * (3.0 - 2.0 * ramp)
+            policy.vel_cmd[:] = (runup_command * ramp, 0.0, 0.0)
+            policy._update_command()
+            step_once()
+
+        entry_quat = data.qpos[qpos_adr + 3:qpos_adr + 7].copy()
+        entry_body_velocity = policy.quat_rotate_inverse(
+            entry_quat, data.qvel[qvel_adr:qvel_adr + 3].copy()
+        )
+        entry_speed = float(entry_body_velocity[0])
+        yaw_at_start = unwrapped_yaw
+        turn_start_xy = data.qpos[qpos_adr:qpos_adr + 2].copy()
+        previous_turn_xy = turn_start_xy.copy()
+        turn_path = 0.0
+        min_speed = float("inf")
+        policy.ground_pick_period = period
+        policy.ground_pick_mode = True
+        policy.ground_pick_phase = 0.0
+        policy.ort_session = policy.ground_pick_session
+        policy.current_policy = "spin_turn"
+        policy._update_command()
+        active_steps = 0
+        while policy.ground_pick_mode:
+            policy.update_ground_pick_phase(control_dt)
+            spin_command = policy.command.copy()
+            spin_obs = policy.get_observations().reshape(1, -1)
+            spin_action = policy.ground_pick_session.run(
+                [policy.ground_pick_session.get_outputs()[0].name],
+                {policy.ground_pick_session.get_inputs()[0].name: spin_obs},
+            )[0].squeeze(0)
+            roller_command = np.zeros_like(policy.command)
+            roller_command[0] = runup_command
+            policy.command[:] = roller_command
+            roller_obs = policy.get_observations().reshape(1, -1)
+            roller_action = policy.walking_session.run(
+                [policy.walking_session.get_outputs()[0].name],
+                {policy.walking_session.get_inputs()[0].name: roller_obs},
+            )[0].squeeze(0)
+            policy.command[:] = spin_command
+            elapsed = active_steps * control_dt
+            alpha = 1.0 if blend_s <= 0.0 else min(1.0, elapsed / blend_s)
+            alpha = alpha * alpha * (3.0 - 2.0 * alpha)
+            mix = alpha * spin_weight
+            action = ((1.0 - mix) * roller_action + mix * spin_action).astype(np.float32)
+            policy.last_action = action.copy()
+            policy.apply_action(action)
+            for _ in range(decimation):
+                mujoco.mj_step(model, data)
+            yaw = yaw_from_quat(data.qpos[qpos_adr + 3:qpos_adr + 7])
+            unwrapped_yaw += math.atan2(
+                math.sin(yaw - previous_yaw), math.cos(yaw - previous_yaw)
+            )
+            previous_yaw = yaw
+            min_upright = min(min_upright, float(-policy.get_projected_gravity()[2]))
+            current_turn_xy = data.qpos[qpos_adr:qpos_adr + 2].copy()
+            turn_path += float(np.linalg.norm(current_turn_xy - previous_turn_xy))
+            previous_turn_xy = current_turn_xy
+            quat = data.qpos[qpos_adr + 3:qpos_adr + 7].copy()
+            body_velocity = policy.quat_rotate_inverse(
+                quat, data.qvel[qvel_adr:qvel_adr + 3].copy()
+            )
+            min_speed = min(min_speed, float(np.linalg.norm(body_velocity[:2])))
+            active_steps += 1
+
+        for _ in range(round(0.8 / control_dt)):
+            policy.vel_cmd[:] = 0.0
+            policy._update_command()
+            step_once()
+
+        drift = float(np.linalg.norm(data.qpos[qpos_adr:qpos_adr + 2] - turn_start_xy))
+        end_quat = data.qpos[qpos_adr + 3:qpos_adr + 7].copy()
+        end_body_velocity = policy.quat_rotate_inverse(
+            end_quat, data.qvel[qvel_adr:qvel_adr + 3].copy()
+        )
+        print(
+            f"{runup_command:.2f},{runup_s:.2f},{entry_speed:.3f},{blend_s:.2f},"
+            f"{spin_weight:.2f},"
+            f"{period:.2f},{active_steps * control_dt:.2f},"
+            f"{math.degrees(unwrapped_yaw - yaw_at_start):.2f},"
+            f"{turn_path:.4f},{min_speed:.3f},{float(np.linalg.norm(end_body_velocity[:2])):.3f},"
+            f"{float(data.qvel[qvel_adr + 5]):.3f},{drift:.4f},{min_upright:.4f}"
+        )
+
+
+if __name__ == "__main__":
+    main()
