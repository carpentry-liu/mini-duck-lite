+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--run-dir", type=Path, default=None)
+    parser.add_argument("--log-file", type=Path, default=None)
+    parser.add_argument("--host", default="0.0.0.0")
+    parser.add_argument("--port", type=int, default=8080)
+    parser.add_argument("--width", type=int, default=512)
+    parser.add_argument("--height", type=int, default=288)
+    parser.add_argument("--fps", type=int, default=25)
+    parser.add_argument("--replay-title", default="MicroDuck 动作 · 50fps 验收回放")
+    parser.add_argument("--replay-subtitle", default="由 ONNX 策略驱动的 MuJoCo 物理回放。")
+    parser.add_argument("--summary-file", type=Path, default=None,
+                        help="Optional acceptance JSON merged into the replay status panel.")
+    parser.add_argument("--selected-checkpoint", default=None,
+                        help="Checkpoint label used by a replay selected after comparison.")
+    parser.add_argument("--live", action="store_true",
+                        help="Use the lower-frame-rate live checkpoint renderer instead of the accepted MP4.")
+    parser.add_argument(
+        "--replay-video",
+        type=Path,
+        default=ROOT / "artifacts/showcase/roller_crouch_spin_final_50fps.mp4",
+    )
+    args = parser.parse_args()
+
+    run_dir = args.run_dir or newest_run()
+    replay_video = None if args.live else args.replay_video
+    if replay_video is not None and not replay_video.is_file():
+        raise FileNotFoundError(replay_video)
+    state = PreviewState(
+        run_dir,
+        args.log_file,
+        args.width,
+        args.height,
+        replay_video=replay_video,
+    )
+    if replay_video is not None:
+        checkpoint_iteration, checkpoint_name = newest_checkpoint(run_dir)
+        state.stats = {
+            "status": "replay",
+            "run": run_dir.name,
+            "checkpoint_iteration": checkpoint_iteration,
+            "checkpoint": args.selected_checkpoint or checkpoint_name,
+            "playback": replay_video.name,
+            "title": args.replay_title,
+            "subtitle": args.replay_subtitle,
+        }
+        if args.summary_file is not None:
+            summary = json.loads(args.summary_file.read_text(encoding="utf-8"))
+            state.stats.update(summary)
+            state.stats["accepted"] = all(summary.get("checks", {}).values())
+    Handler.state = state
+    worker = None
+    if replay_video is None:
+        worker = threading.Thread(target=build_simulation, args=(state, args.fps), daemon=True)
+        worker.start()
+    server = ThreadingHTTPServer((args.host, args.port), Handler)
+    mode = "live checkpoint renderer" if replay_video is None else f"50 fps replay: {replay_video}"
+    print(f"Training preview: http://localhost:{args.port}/ ({mode})")
+    print(f"Watching run: {run_dir}")
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        state.stop.set()
+        server.server_close()
+        if worker is not None:
+            worker.join(timeout=5.0)
+
+
+if __name__ == "__main__":
+    main()
