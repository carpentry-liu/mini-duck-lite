+#!/usr/bin/env python3
+"""Serve a live rendered preview of the newest spin training checkpoint.
+
+The 4096 training environments remain headless.  This sidecar watches the ONNX
+export in the run directory, loads it into one MuJoCo evaluation environment,
+and exposes the resulting frames on a tiny local web page.
+"""
+
+from __future__ import annotations
+
+import argparse
+import io
+import json
+import math
+import os
+import re
+import threading
+import time
+from http import HTTPStatus
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import mujoco
+import numpy as np
+import onnxruntime as ort
+from PIL import Image
+
+from infer_policy import DEFAULT_POSE, PolicyInference
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SCENE = ROOT / "src/mjlab_microduck/robot/microduck/scene_roller_showcase.xml"
+ROLLER = ROOT / "policies/upstream/roller.onnx"
+ITERATION_RE = re.compile(r"Learning iteration\s+(\d+)/")
+
+
+def newest_run() -> Path:
+    candidates = [path for path in (ROOT / "logs/rsl_rl/spin").glob("*") if path.is_dir()]
+    if not candidates:
+        raise FileNotFoundError("No spin run found under logs/rsl_rl/spin")
+    return max(candidates, key=lambda path: path.stat().st_mtime)
+
+
+def newest_checkpoint(run_dir: Path) -> tuple[int, str]:
+    checkpoints = []
+    for path in run_dir.glob("model_*.pt"):
+        try:
+            checkpoints.append((int(path.stem.split("_")[-1]), path.name))
+        except ValueError:
+            continue
+    return max(checkpoints, default=(0, "waiting for model_0.pt"))
+
+
+class PreviewState:
+    def __init__(
+        self,
+        run_dir: Path,
+        log_file: Path | None,
+        width: int,
+        height: int,
+        replay_video: Path | None = None,
+    ):
+        self.run_dir = run_dir
+        self.log_file = log_file
+        self.replay_video = replay_video
+        self.width = width
+        self.height = height
+        self.lock = threading.Lock()
+        self.frame_ready = threading.Condition(self.lock)
+        self.frame_id = 0
+        self.jpeg = b""
+        self.stats: dict[str, object] = {
+            "status": "starting",
+            "run": run_dir.name,
+            "iteration": 0,
+            "checkpoint": "waiting",
+        }
+        self.stop = threading.Event()
+
+    def publish(self, frame: np.ndarray, stats: dict[str, object]) -> None:
+        buffer = io.BytesIO()
+        # Optimized JPEG encoding costs more CPU than the MuJoCo preview itself
+        # on WSL software rendering.  Regular encoding is substantially faster
+        # and keeps the live stream cadence stable.
+        Image.fromarray(frame).save(buffer, format="JPEG", quality=82)
+        with self.frame_ready:
+            self.jpeg = buffer.getvalue()
+            self.stats = stats
+            self.frame_id += 1
+            self.frame_ready.notify_all()
+
+    def snapshot(self) -> tuple[bytes, dict[str, object]]:
+        with self.lock:
+            return self.jpeg, dict(self.stats)
+
+    def wait_for_frame(self, after_id: int) -> tuple[bytes, int]:
+        with self.frame_ready:
+            self.frame_ready.wait_for(
+                lambda: self.frame_id != after_id or self.stop.is_set(),
+                timeout=1.0,
+            )
+            return self.jpeg, self.frame_id
+
+
+def read_iteration(log_file: Path | None, fallback: int) -> int:
+    if log_file is None or not log_file.is_file():
+        return fallback
+    try:
+        matches = ITERATION_RE.findall(log_file.read_text(encoding="utf-8", errors="ignore"))
+        return int(matches[-1]) if matches else fallback
+    except OSError:
+        return fallback
+
+
+def build_simulation(state: PreviewState, fps: int) -> None:
+    os.environ.setdefault("MUJOCO_GL", "egl")
+    onnx_files = list(state.run_dir.glob("*.onnx"))
+    if not onnx_files:
+        raise FileNotFoundError(f"No ONNX export in {state.run_dir}")
+    spin_path = onnx_files[0]
+
+    model = mujoco.MjModel.from_xml_path(str(SCENE))
+    model.opt.timestep = 0.005
+    data = mujoco.MjData(model)
+    renderer = mujoco.Renderer(model, height=state.height, width=state.width)
+
+    for joint_id in range(model.njnt):
+        name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, joint_id)
+        if name and name.startswith("passive_"):
+            model.dof_frictionloss[model.jnt_dofadr[joint_id]] = 0.003
+
+    policy = PolicyInference(
+        model,
+        data,
+        walking_onnx_path=str(ROLLER),
+        ground_pick_onnx_path=str(spin_path),
+        ground_pick_period=4.0,
+        use_projected_gravity=True,
+        new_cmd_obs=True,
+    )
+    loaded_mtime_ns = spin_path.stat().st_mtime_ns
+    freejoint_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, "trunk_base_freejoint")
+    qpos_adr = int(model.jnt_qposadr[freejoint_id])
+    qvel_adr = int(model.jnt_dofadr[freejoint_id])
+
+    def reset() -> None:
+        mujoco.mj_resetData(model, data)
+        data.qpos[qpos_adr:qpos_adr + 7] = (0.0, 0.0, 0.1385, 1.0, 0.0, 0.0, 0.0)
+        for index, joint_qpos_index in enumerate(policy.joint_qpos_indices):
+            data.qpos[joint_qpos_index] = DEFAULT_POSE[index]
+        data.ctrl[:] = DEFAULT_POSE[: model.nu]
+        policy.last_action[:] = 0.0
+        policy.ground_pick_mode = False
+        policy.current_policy = "walking"
+        policy.ort_session = policy.walking_session
+        policy.vel_cmd[:] = 0.0
+        policy.head_offset[:] = 0.0
+        policy._update_command()
+        mujoco.mj_forward(model, data)
+
+    reset()
+    episode_time = 0.0
+    spin_started = False
+    control_dt = 0.02
+    decimation = 4
+    next_frame = 0.0
+    frame_period = 1.0 / fps
+    last_iteration_check = 0.0
+    iteration = 0
+
+    try:
+        while not state.stop.is_set():
+            wall_start = time.monotonic()
+            episode_time += control_dt
+
+            # New exports arrive only at checkpoint boundaries.  Reload safely
+            # between episodes so a file replacement can never split a cycle.
+            if episode_time >= 5.0:
+                episode_time = 0.0
+                next_frame = 0.0
+                spin_started = False
+                try:
+                    mtime_ns = spin_path.stat().st_mtime_ns
+                    if mtime_ns != loaded_mtime_ns:
+                        policy.ground_pick_session = ort.InferenceSession(
+                            str(spin_path), providers=["CPUExecutionProvider"]
+                        )
+                        loaded_mtime_ns = mtime_ns
+                except (OSError, RuntimeError):
+                    pass
+                reset()
+
+            if episode_time >= 0.6 and not spin_started:
+                policy.trigger_ground_pick()
+                spin_started = True
+
+            policy.update_ground_pick_phase(control_dt)
+            action = policy.infer()
+            policy.apply_action(action)
+            for _ in range(decimation):
+                mujoco.mj_step(model, data)
+
+            if episode_time + 1e-9 >= next_frame:
+                camera = mujoco.MjvCamera()
+                camera.type = mujoco.mjtCamera.mjCAMERA_FREE
+                camera.lookat[:] = (float(data.qpos[qpos_adr]), 0.0, 0.14)
+                camera.distance = 0.78
+                camera.azimuth = 92.0
+                camera.elevation = -12.0
+                renderer.update_scene(data, camera=camera)
+                frame = renderer.render()
+
+                now = time.monotonic()
+                if now - last_iteration_check >= 2.0:
+                    checkpoint_iteration, checkpoint_name = newest_checkpoint(state.run_dir)
+                    iteration = read_iteration(state.log_file, iteration)
+                    last_iteration_check = now
+                else:
+                    checkpoint_iteration, checkpoint_name = newest_checkpoint(state.run_dir)
+
+                quat = data.qpos[qpos_adr + 3:qpos_adr + 7]
+                yaw = math.degrees(math.atan2(
+                    2.0 * (quat[0] * quat[3] + quat[1] * quat[2]),
+                    1.0 - 2.0 * (quat[2] ** 2 + quat[3] ** 2),
+                ))
+                state.publish(
+                    frame,
+                    {
+                        "status": "live",
+                        "run": state.run_dir.name,
+                        "iteration": iteration,
+                        "checkpoint_iteration": checkpoint_iteration,
+                        "checkpoint": checkpoint_name,
+                        "active_policy": policy.current_policy,
+                        "episode_time_s": round(episode_time, 2),
+                        "trunk_height_m": round(float(data.qpos[qpos_adr + 2]), 3),
+                        "yaw_deg": round(yaw, 1),
+                        "yaw_rate_radps": round(float(data.qvel[qvel_adr + 5]), 2),
+                        "upright": round(float(-policy.get_projected_gravity()[2]), 3),
+                        "export_updated": time.strftime(
+                            "%H:%M:%S", time.localtime(spin_path.stat().st_mtime)
+                        ),
+                    },
+                )
+                next_frame += frame_period
+
+            sleep_s = control_dt - (time.monotonic() - wall_start)
+            if sleep_s > 0:
+                time.sleep(sleep_s)
+    finally:
+        renderer.close()
+
