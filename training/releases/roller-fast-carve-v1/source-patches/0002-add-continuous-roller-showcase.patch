+"""Deterministic timeline and metrics helpers for the roller showcase.
+
+The showcase deliberately separates choreography from control.  The timeline
+only selects a command/policy; every joint target still comes from an ONNX
+policy, except the final head pose which is a command understood by the roller
+policy itself.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class ShowcasePhase:
+    """One segment of the short-form-video choreography."""
+
+    name: str
+    start: float
+    end: float
+    policy: str
+    forward_command: float = 0.0
+    cycle_period: float | None = None
+    action_blend_s: float = 0.0
+    action_mix: float = 1.0
+    head_command: tuple[float, float, float, float] = (0.0, 0.0, 0.0, 0.0)
+
+    def contains(self, time_s: float) -> bool:
+        return self.start <= time_s < self.end
+
+
+ROLLER_SHOWCASE_TIMELINE = (
+    # Establishing shot: the duck starts far from the obstacle instead of
+    # appearing beside it, then builds speed over a visibly long runway.
+    ShowcasePhase("settle", 0.0, 0.8, "roller"),
+    ShowcasePhase("long_approach", 0.8, 4.8, "roller", forward_command=0.55),
+    # Enter the spin policy while still rolling.  A short action cross-fade and
+    # persistent roller/spin action mixing produce a ~90° carving arc at
+    # ~0.49 m/s entry speed; the roller policy never switches off completely.
+    ShowcasePhase(
+        "carve_turn", 4.8, 5.62, "turn", forward_command=0.55,
+        cycle_period=1.16, action_blend_s=0.08, action_mix=0.82,
+    ),
+    ShowcasePhase("corner_exit", 5.62, 8.62, "roller", forward_command=0.55),
+    # The dynamic crouch policy uses a 5 s clock: 0.6 s down, 1.6 s low,
+    # then a 1.0 s gradual rise.  The gate is crossed before recovery starts.
+    ShowcasePhase(
+        "crouch_gate", 8.62, 12.12, "crouch", cycle_period=5.0, action_blend_s=0.16
+    ),
+    # Keep rolling after the bar so the spin happens in its own readable zone
+    # instead of being hidden behind the obstacle in the replay camera.
+    ShowcasePhase("exit_gate", 12.12, 13.12, "roller", forward_command=0.0),
+    # Exit speed contributes angular impulse when the spin controller engages;
+    # this calibrated clock completes one turn without the 60° overshoot seen
+    # with the standing-start deployment period.
+    ShowcasePhase("spin_360", 13.12, 16.04, "spin", cycle_period=4.15),
+    ShowcasePhase("hard_brake", 16.04, 17.24, "roller"),
+    ShowcasePhase(
+        "head_tilt_finish",
+        17.24,
+        19.48,
+        "roller",
+        head_command=(0.0, -0.07, 0.20, 0.16),
+    ),
+)
+
+
+def phase_at(time_s: float) -> ShowcasePhase:
+    """Return the active phase, clamping past-the-end time to the finale."""
+
+    for phase in ROLLER_SHOWCASE_TIMELINE:
+        if phase.contains(time_s):
+            return phase
+    return ROLLER_SHOWCASE_TIMELINE[-1]
+
+
+def total_duration() -> float:
+    return ROLLER_SHOWCASE_TIMELINE[-1].end
+
+
+def smoothstep01(value: float) -> float:
+    """Clamp ``value`` to [0, 1] and apply a zero-slope cubic easing curve."""
+
+    clamped = min(1.0, max(0.0, value))
+    return clamped * clamped * (3.0 - 2.0 * clamped)
