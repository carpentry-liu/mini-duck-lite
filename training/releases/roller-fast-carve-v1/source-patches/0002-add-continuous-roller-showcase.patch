+async function updateStats(){try{const s=await fetch('/status.json',{cache:'no-store'}).then(r=>r.json());document.getElementById('title').textContent=s.title||'MicroDuck 动作 · 50fps 验收回放';document.getElementById('subtitle').textContent=s.subtitle||'由 ONNX 策略驱动的 MuJoCo 物理回放。';const common=[['回放文件',s.playback],['训练检查点',s.checkpoint],['编码帧率','50 fps'],['总帧数',s.duration_s?Math.round(s.duration_s*50):'—'],['时长',s.duration_s?`${n(s.duration_s,2)} s`:'—']];const route=s.route_length_m?[['完整路线',`${n(s.route_length_m,2)} m`],['入弯 / 最低速度',`${n(s.turn_entry_speed_mps,3)} / ${n(s.turn_min_speed_mps,3)} m/s`],['弧线 / 转角',`${n(s.turn_path_m*100,1)} cm / ${n(s.corner_turn_deg,1)}°`],['穿杆窗口最低速度',`${n(s.gate_window_min_speed_mps,3)} m/s`],['穿杆时嘴尖高度',`${n(s.gate_crossing_jaw_z_m*100,1)} cm`],['低姿滑行',`${n(s.crouch_progress_m,2)} m`],['离杆后再起身',s.recovered_after_gate?'PASS':'FAIL'],['旋转角度',`${n(s.spin_yaw_deg,1)}°`],['最终速度',`${n(s.final_planar_speed_mps,3)} m/s`]]:[['平均姿态误差',s.mean_pose_mae_rad?`${n(s.mean_pose_mae_rad*180/Math.PI,2)}°`:'—'],['最低直立度',n(s.min_upright)],['最大漂移',s.max_planar_drift_m?`${n(s.max_planar_drift_m*100,2)} cm`:'—'],['头部左右摆幅',s.head_yaw_range_rad?`${n(s.head_yaw_range_rad*180/Math.PI,1)}°`:'—']];const rows=[...common,...route,['验收结果',s.accepted?'PASS':'—']];document.getElementById('stats').innerHTML=rows.map(([k,v])=>`<div class="row"><span class="muted">${k}</span><span class="value">${v}</span></div>`).join('')}catch(e){}}
