+#!/usr/bin/env python3
+"""Render and measure the MicroDuck roller showcase without a GUI.
+
+This is an acceptance runner, not a canned animation: joint targets come from
+the supplied ONNX policies while MuJoCo advances the physics.  It produces an
+MP4 and a per-control-step CSV so motion can be checked from both pixels and
+numbers.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+import os
+from pathlib import Path
+
+import imageio.v2 as imageio
+import mujoco
+import numpy as np
+import onnxruntime as ort
+
+from infer_policy import DEFAULT_POSE, PolicyInference
+from mjlab_microduck.showcase import phase_at, smoothstep01, total_duration
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SCENE = ROOT / "src/mjlab_microduck/robot/microduck/scene_roller_showcase.xml"
+DEFAULT_ROLLER = ROOT / "policies/upstream/roller.onnx"
+DEFAULT_CROUCH = ROOT / "policies/upstream/roller_crouch.onnx"
+START_X = -1.80
+START_Y = -0.65
+GATE_X = -0.583
+GATE_Y = 1.224
+LANE_HEADING_RAD = math.radians(112.2)
+LANE_FORWARD = np.asarray(
+    (math.cos(LANE_HEADING_RAD), math.sin(LANE_HEADING_RAD)), dtype=np.float64
+)
+LANE_LATERAL = np.asarray((-LANE_FORWARD[1], LANE_FORWARD[0]), dtype=np.float64)
+
+
+def _gate_coordinates(row: dict[str, float | str | bool]) -> tuple[float, float]:
+    offset = np.asarray(
+        (float(row["x_m"]) - GATE_X, float(row["y_m"]) - GATE_Y),
+        dtype=np.float64,
+    )
+    return float(offset @ LANE_FORWARD), float(offset @ LANE_LATERAL)
+
+
+def _yaw_from_quat(quat: np.ndarray) -> float:
+    qw, qx, qy, qz = quat
+    return math.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
+
+
+def _set_velocity_quiet(policy: PolicyInference, x: float) -> None:
+    policy.vel_cmd[:] = (x, 0.0, 0.0)
+    policy._update_policy_session()
+    policy._update_command()
+
+
+def _switch_cyclic_policy(
+    policy: PolicyInference,
+    session: ort.InferenceSession,
+    name: str,
+    period_s: float,
+) -> None:
+    policy.ground_pick_session = session
+    policy.ground_pick_period = period_s
+    policy.ground_pick_mode = True
+    policy.ground_pick_phase = 0.0
+    policy.ort_session = session
+    policy.current_policy = name
+    policy._update_command()
+
+
+def _finish_cyclic_policy(policy: PolicyInference) -> None:
+    policy.ground_pick_mode = False
+    policy.ground_pick_phase = 0.0
+    policy.current_policy = "walking"
+    policy.ort_session = policy.walking_session
+    policy._update_command()
+
+
+def _infer_session(
+    policy: PolicyInference,
+    session: ort.InferenceSession,
+    command: np.ndarray,
+) -> np.ndarray:
+    """Infer one policy against the shared physical state and action history."""
+    saved_command = policy.command.copy()
+    policy.command[:] = command
+    obs = policy.get_observations().reshape(1, -1)
+    action = session.run(
+        [session.get_outputs()[0].name],
+        {session.get_inputs()[0].name: obs},
+    )[0].squeeze(0).astype(np.float32)
+    policy.command[:] = saved_command
+    return action
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--roller", type=Path, default=DEFAULT_ROLLER)
+    parser.add_argument("--crouch", type=Path, default=DEFAULT_CROUCH)
+    parser.add_argument("--spin", type=Path, default=None,
+                        help="Optional trained spin policy; without it the spin segment is a measured coast.")
+    parser.add_argument("--video", type=Path,
+                        default=ROOT / "artifacts/showcase/roller_showcase.mp4")
+    parser.add_argument("--metrics", type=Path,
+                        default=ROOT / "artifacts/showcase/roller_showcase_metrics.csv")
+    parser.add_argument("--summary", type=Path,
+                        default=ROOT / "artifacts/showcase/roller_showcase_summary.json")
+    parser.add_argument("--width", type=int, default=960)
+    parser.add_argument("--height", type=int, default=540)
+    parser.add_argument("--fps", type=int, default=50,
+                        help="Output frame rate; 50 matches the policy control rate exactly.")
+    parser.add_argument("--duration", type=float, default=total_duration())
+    parser.add_argument("--no-video", action="store_true")
+    return parser
+
+
+def main() -> None:
+    args = build_parser().parse_args()
+    for path in (args.roller, args.crouch):
+        if not path.is_file():
+            raise FileNotFoundError(path)
+    if args.spin is not None and not args.spin.is_file():
+        raise FileNotFoundError(args.spin)
+
+    model = mujoco.MjModel.from_xml_path(str(SCENE))
+    model.opt.timestep = 0.005
+    data = mujoco.MjData(model)
+
+    # Match inference.py and the training model: passive roller bearing loss.
+    for joint_id in range(model.njnt):
+        name = mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, joint_id)
+        if name and name.startswith("passive_"):
+            model.dof_frictionloss[model.jnt_dofadr[joint_id]] = 0.003
+
+    policy = PolicyInference(
+        model,
+        data,
+        walking_onnx_path=str(args.roller),
+        ground_pick_onnx_path=str(args.crouch),
+        ground_pick_period=4.0,
+        use_projected_gravity=True,
+        new_cmd_obs=True,
+    )
+    crouch_session = policy.ground_pick_session
+    spin_session = (
+        ort.InferenceSession(str(args.spin), providers=["CPUExecutionProvider"])
+        if args.spin is not None
+        else None
+    )
+
+    freejoint_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, "trunk_base_freejoint")
+    qpos_adr = int(model.jnt_qposadr[freejoint_id])
+    qvel_adr = int(model.jnt_dofadr[freejoint_id])
+    jaw_body_id = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "jaw_soft")
+    head_pitch_joint_id = mujoco.mj_name2id(
+        model, mujoco.mjtObj.mjOBJ_JOINT, "head_pitch"
+    )
+    head_pitch_qpos_adr = int(model.jnt_qposadr[head_pitch_joint_id])
+    data.qpos[qpos_adr:qpos_adr + 7] = (START_X, START_Y, 0.1385, 1.0, 0.0, 0.0, 0.0)
+    for index, joint_qpos_index in enumerate(policy.joint_qpos_indices):
+        data.qpos[joint_qpos_index] = DEFAULT_POSE[index]
+    data.ctrl[:] = DEFAULT_POSE[: model.nu]
+    mujoco.mj_forward(model, data)
+
+    control_dt = 0.02
+    decimation = int(round(control_dt / model.opt.timestep))
+    render_dt = 1.0 / args.fps
+    next_render_time = 0.0
+    current_phase_name = None
+    last_forward_speed = 0.0
+    previous_action = np.zeros(model.nu, dtype=np.float32)
+    transition_from_action = previous_action.copy()
+    transition_started_at = -1.0
+    transition_duration = 0.12
+    camera_azimuth = 92.0
+    camera_distance = 2.35
+    camera_lookat = np.asarray((-0.85, -0.30, 0.14), dtype=np.float64)
+    rows: list[dict[str, float | str | bool]] = []
+    path_length_m = 0.0
+    previous_xy = data.qpos[qpos_adr:qpos_adr + 2].copy()
+
+    writer = None
+    renderer = None
+    if not args.no_video:
+        os.environ.setdefault("MUJOCO_GL", "egl")
+        args.video.parent.mkdir(parents=True, exist_ok=True)
+        writer = imageio.get_writer(
+            args.video,
+            fps=args.fps,
+            codec="libx264",
+            quality=8,
+            pixelformat="yuv420p",
+            macro_block_size=None,
+        )
+        renderer = mujoco.Renderer(model, height=args.height, width=args.width)
+
+    initial_yaw = _yaw_from_quat(data.qpos[qpos_adr + 3:qpos_adr + 7])
+    previous_yaw = initial_yaw
+    unwrapped_yaw = initial_yaw
+    steps = int(math.ceil(args.duration / control_dt))
+    try:
+        for step in range(steps):
+            time_s = step * control_dt
+            phase = phase_at(time_s)
+
+            if phase.name != current_phase_name:
+                transition_from_action = previous_action.copy()
+                # Cyclic crouch/spin policies need their learned first action
+                # intact.  Blend only when the roller policy takes control for
+                # braking or the final pose.
+                transition_duration = phase.action_blend_s or 0.12
+                transition_started_at = (
+                    time_s
+                    if phase.policy == "roller" or phase.action_blend_s > 0.0
+                    else time_s - transition_duration
+                )
+                # The run-up command already has a smooth velocity ramp; a
+                # second action-space blend changed the learned skate rhythm
+                # and produced an unintended speed/yaw surge.
+                if phase.name in {"settle", "long_approach"}:
+                    transition_started_at = time_s - transition_duration
+                if current_phase_name in {"carve_turn", "crouch_gate", "spin_360"}:
+                    _finish_cyclic_policy(policy)
+                current_phase_name = phase.name
+                if phase.policy == "crouch":
+                    assert phase.cycle_period is not None
+                    _switch_cyclic_policy(
+                        policy, crouch_session, "crouch", phase.cycle_period
+                    )
+                elif phase.policy in {"turn", "spin"} and spin_session is not None:
+                    assert phase.cycle_period is not None
+                    _switch_cyclic_policy(
+                        policy, spin_session, phase.name, phase.cycle_period
+                    )
+                else:
+                    _set_velocity_quiet(policy, phase.forward_command)
+                print(f"[{time_s:5.2f}s] phase={phase.name} policy={policy.current_policy}")
+
+            # The cyclic policies own the first three command slots.  The base
+            # roller policy receives velocity/head commands in its own segments.
+            if phase.policy in {"crouch", "turn", "spin"} and (
+                phase.policy == "crouch" or spin_session is not None
+            ):
+                policy.update_ground_pick_phase(control_dt)
+            elif phase.policy in {"turn", "spin"} and spin_session is None:
+                _set_velocity_quiet(policy, 0.0)
+            else:
+                head_alpha = 1.0
+                if phase.name == "head_tilt_finish":
+                    # Avoid an unrealistic step command on a head that accounts
+                    # for a large fraction of MicroDuck's mass.
+                    head_alpha = min(1.0, max(0.0, (time_s - phase.start) / 1.0))
+                policy.head_offset[:] = np.asarray(phase.head_command) * head_alpha
+                forward_command = phase.forward_command
+                if phase.name == "long_approach":
+                    # Ease into the velocity command rather than kicking the
+                    # learned controller from zero to full speed in one tick.
+                    command_alpha = smoothstep01((time_s - phase.start) / 0.50)
+                    forward_command *= command_alpha
+                if phase.name in {"hard_brake", "head_tilt_finish"}:
+                    # The roller policy interprets zero as coasting.  Use a
+                    # small hysteretic counter-command until the measured body
+                    # speed is near zero, then coast instead of reversing.
+                    if last_forward_speed > 0.04:
+                        forward_command = -0.50
+                    elif last_forward_speed < -0.04:
+                        forward_command = 0.25
+                    else:
+                        forward_command = 0.0
+                _set_velocity_quiet(policy, forward_command)
+
+            transition_alpha = smoothstep01(
+                (time_s - transition_started_at) / transition_duration
+            )
+            if phase.policy == "turn" and spin_session is not None:
+                spin_command = policy.command.copy()
+                spin_action = _infer_session(policy, spin_session, spin_command)
+                roller_command = np.zeros_like(policy.command)
+                roller_command[0] = phase.forward_command
+                roller_action = _infer_session(
+                    policy, policy.walking_session, roller_command
+                )
+                mix = transition_alpha * phase.action_mix
+                action = (
+                    (1.0 - mix) * roller_action + mix * spin_action
+                ).astype(np.float32)
+                policy.last_action = action.copy()
+            else:
+                action = policy.infer()
+            if phase.policy != "turn" and transition_alpha < 1.0:
+                action = (
+                    (1.0 - transition_alpha) * transition_from_action
+                    + transition_alpha * action
+                ).astype(np.float32)
+                # The last-action observation must describe what was applied,
+                # not the unblended policy output returned by infer().
+                policy.last_action = action.copy()
+            policy.apply_action(action)
+            previous_action = action.copy()
+            for _ in range(decimation):
+                mujoco.mj_step(model, data)
+
+            quat = data.qpos[qpos_adr + 3:qpos_adr + 7].copy()
+            world_velocity = data.qvel[qvel_adr:qvel_adr + 3].copy()
+            body_velocity = policy.quat_rotate_inverse(quat, world_velocity)
+            last_forward_speed = float(body_velocity[0])
+            yaw = _yaw_from_quat(quat)
+            yaw_step = math.atan2(math.sin(yaw - previous_yaw), math.cos(yaw - previous_yaw))
+            unwrapped_yaw += yaw_step
+            previous_yaw = yaw
+            current_xy = data.qpos[qpos_adr:qpos_adr + 2].copy()
+            path_length_m += float(np.linalg.norm(current_xy - previous_xy))
+            previous_xy = current_xy
+            rows.append(
+                {
+                    "time_s": time_s,
+                    "phase": phase.name,
+                    "policy": policy.current_policy,
+                    "spin_policy_loaded": spin_session is not None,
+                    "x_m": float(data.qpos[qpos_adr]),
+                    "y_m": float(data.qpos[qpos_adr + 1]),
+                    "trunk_z_m": float(data.qpos[qpos_adr + 2]),
+                    "forward_mps": float(body_velocity[0]),
+                    "lateral_mps": float(body_velocity[1]),
+                    "planar_speed_mps": float(np.linalg.norm(body_velocity[:2])),
+                    "jaw_z_m": float(data.xpos[jaw_body_id, 2]),
+                    "head_pitch_rad": float(data.qpos[head_pitch_qpos_adr]),
+                    "yaw_rate_radps": float(data.qvel[qvel_adr + 5]),
+                    "yaw_delta_deg": math.degrees(unwrapped_yaw - initial_yaw),
+                    "upright_score": float(-policy.get_projected_gravity()[2]),
+                }
+            )
+
+            if phase.name in {"settle", "long_approach"}:
+                target_camera_distance = 2.35
+                target_camera_azimuth = 92.0
+                target_camera_lookat = np.asarray((-0.85, -0.30, 0.14))
+            elif phase.name == "carve_turn":
+                target_camera_distance = 1.05
+                target_camera_azimuth = 138.0
+                target_camera_lookat = np.asarray(
+                    (float(data.qpos[qpos_adr]), float(data.qpos[qpos_adr + 1]), 0.14)
+                )
+            elif phase.name in {"corner_exit", "crouch_gate", "exit_gate"}:
+                target_camera_distance = 1.12
+                target_camera_azimuth = 58.0
+                target_camera_lookat = np.asarray(
+                    (float(data.qpos[qpos_adr]), float(data.qpos[qpos_adr + 1]) + 0.10, 0.14)
+                )
+            elif phase.name == "spin_360":
+                target_camera_distance = 0.88
+                # Hold the gate-side camera through the spin.  Swinging behind
+                # the bar during this transition briefly hid the robot.
+                target_camera_azimuth = 58.0
+                target_camera_lookat = np.asarray(
+                    (float(data.qpos[qpos_adr]), float(data.qpos[qpos_adr + 1]), 0.14)
+                )
+            else:
+                target_camera_distance = 0.62
+                target_camera_azimuth = 175.0
+                target_camera_lookat = np.asarray(
+                    (float(data.qpos[qpos_adr]), float(data.qpos[qpos_adr + 1]), 0.14)
+                )
+            # A damped camera avoids a visible cut when the choreography moves
+            # between forward motion, spin and the final close-up.
+            camera_alpha = 1.0 - math.exp(-control_dt / 0.35)
+            camera_distance += (target_camera_distance - camera_distance) * camera_alpha
+            camera_azimuth += (target_camera_azimuth - camera_azimuth) * camera_alpha
+            camera_lookat += (target_camera_lookat - camera_lookat) * camera_alpha
+
+            if renderer is not None and writer is not None and time_s + 1e-9 >= next_render_time:
+                camera = mujoco.MjvCamera()
+                camera.type = mujoco.mjtCamera.mjCAMERA_FREE
+                camera.lookat[:] = camera_lookat
+                camera.distance = camera_distance
+                camera.azimuth = camera_azimuth
+                camera.elevation = -13.0
+                renderer.update_scene(data, camera=camera)
+                writer.append_data(renderer.render())
+                next_render_time += render_dt
+    finally:
+        if writer is not None:
+            writer.close()
+        if renderer is not None:
+            renderer.close()
+
+    args.metrics.parent.mkdir(parents=True, exist_ok=True)
+    with args.metrics.open("w", encoding="utf-8", newline="") as file:
+        csv_writer = csv.DictWriter(file, fieldnames=rows[0].keys())
+        csv_writer.writeheader()
+        csv_writer.writerows(rows)
+
+    start_x = float(rows[0]["x_m"])
+    end_x = float(rows[-1]["x_m"])
+    min_z = min(float(row["trunk_z_m"]) for row in rows)
+    min_upright = min(float(row["upright_score"]) for row in rows)
+    max_speed = max(float(row["forward_mps"]) for row in rows)
+    approach_rows = [row for row in rows if row["phase"] == "long_approach"]
+    approach_distance = 0.0
+    if approach_rows:
+        approach_distance = math.hypot(
+            float(approach_rows[-1]["x_m"]) - float(approach_rows[0]["x_m"]),
+            float(approach_rows[-1]["y_m"]) - float(approach_rows[0]["y_m"]),
+        )
+    crouch_rows = [row for row in rows if row["phase"] == "crouch_gate"]
+    exit_gate_rows = [row for row in rows if row["phase"] == "exit_gate"]
+    turn_rows = [row for row in rows if row["phase"] == "carve_turn"]
+    corner_exit_rows = [row for row in rows if row["phase"] == "corner_exit"]
+    corner_delta = 0.0
+    corner_final_rate = 0.0
+    turn_path = 0.0
+    turn_entry_speed = 0.0
+    turn_min_speed = 0.0
+    if turn_rows:
+        corner_delta = (
+            float(turn_rows[-1]["yaw_delta_deg"])
+            - float(turn_rows[0]["yaw_delta_deg"])
+        )
+        turn_entry_speed = float(turn_rows[0]["planar_speed_mps"])
+        turn_min_speed = min(float(row["planar_speed_mps"]) for row in turn_rows)
+        for previous, current in zip(turn_rows, turn_rows[1:]):
+            turn_path += math.hypot(
+                float(current["x_m"]) - float(previous["x_m"]),
+                float(current["y_m"]) - float(previous["y_m"]),
+            )
+        corner_window = corner_exit_rows[-max(1, int(round(0.3 / control_dt))):]
+        corner_final_rate = sum(
+            float(row["yaw_rate_radps"]) for row in corner_window
+        ) / len(corner_window)
+    gate_window = [row for row in crouch_rows if (
+        abs(_gate_coordinates(row)[0]) <= 0.15
+        and abs(_gate_coordinates(row)[1]) <= 0.20
+    )]
+    crossing_row = min(
+        gate_window, key=lambda row: abs(_gate_coordinates(row)[0])
+    ) if gate_window else None
+    crouch_longitudinal = [_gate_coordinates(row)[0] for row in crouch_rows]
+    gate_crossed = bool(
+        crouch_rows
+        and min(crouch_longitudinal) <= -0.08
+        and max(crouch_longitudinal) >= 0.12
+        and crossing_row is not None
+    )
+    gate_crossing_speed = (
+        float(crossing_row["planar_speed_mps"]) if crossing_row else 0.0
+    )
+    gate_crossing_trunk_z = (
+        float(crossing_row["trunk_z_m"]) if crossing_row else float("inf")
+    )
+    gate_crossing_head_pitch = (
+        float(crossing_row["head_pitch_rad"]) if crossing_row else 0.0
+    )
+    gate_crossing_jaw_z = (
+        float(crossing_row["jaw_z_m"]) if crossing_row else float("inf")
+    )
+    gate_window_min_speed = min(
+        (float(row["planar_speed_mps"]) for row in gate_window), default=0.0
+    )
+    crouch_progress = (
+        max(crouch_longitudinal) - min(crouch_longitudinal)
+        if crouch_rows else 0.0
+    )
+    crouch_min_trunk_z = min(
+        (float(row["trunk_z_m"]) for row in crouch_rows), default=float("inf")
+    )
+    recovered_after_gate = bool(
+        crossing_row
+        and any(
+            float(row["time_s"]) > float(crossing_row["time_s"])
+            and _gate_coordinates(row)[0] >= 0.12
+            and float(row["trunk_z_m"]) >= crouch_min_trunk_z + 0.025
+            and float(row["jaw_z_m"]) >= gate_crossing_jaw_z + 0.015
+            for row in (*crouch_rows, *exit_gate_rows)
+        )
+    )
+    spin_rows = [row for row in rows if row["phase"] == "spin_360"]
+    spin_delta = (
+        float(spin_rows[-1]["yaw_delta_deg"]) - float(spin_rows[0]["yaw_delta_deg"])
+        if spin_rows
+        else 0.0
+    )
+    spin_drift = 0.0
+    spin_min_upright = 0.0
+    spin_final_yaw_rate = 0.0
+    if spin_rows:
+        dx = float(spin_rows[-1]["x_m"]) - float(spin_rows[0]["x_m"])
+        dy = float(spin_rows[-1]["y_m"]) - float(spin_rows[0]["y_m"])
+        spin_drift = math.hypot(dx, dy)
+        spin_min_upright = min(float(row["upright_score"]) for row in spin_rows)
+        final_window = spin_rows[-max(1, int(round(0.4 / control_dt))):]
+        spin_final_yaw_rate = sum(float(row["yaw_rate_radps"]) for row in final_window) / len(final_window)
+    spin_pass = bool(
+        spin_session is not None
+        and 315.0 <= spin_delta <= 405.0
+        # The marker radius is 0.24 m; a 0.15 m centre displacement keeps the
+        # whole trick visibly inside its marked spin zone.
+        and spin_drift <= 0.15
+        and spin_min_upright >= 0.95
+        and abs(spin_final_yaw_rate) <= 0.25
+    )
+    final_speed = math.hypot(
+        float(rows[-1]["forward_mps"]), float(rows[-1]["lateral_mps"])
+    )
+    route_pass = bool(
+        approach_distance >= 1.0
+        and 75.0 <= corner_delta <= 105.0
+        and turn_entry_speed >= 0.45
+        and turn_min_speed >= 0.20
+        and turn_path >= 0.30
+        and abs(corner_final_rate) <= 0.30
+        and gate_crossed
+        and gate_crossing_speed >= 0.25
+        and gate_window_min_speed >= 0.20
+        and gate_crossing_trunk_z <= 0.10
+        and gate_crossing_jaw_z <= 0.19
+        and crouch_progress >= 0.30
+        and recovered_after_gate
+        and spin_pass
+        and final_speed <= 0.06
+    )
+    summary = {
+        "scenario": "远距离轮滑 → 90° 转弯 → 下蹲穿杆 → 360° 旋转 → 急停歪头",
+        "duration_s": args.duration,
+        "route_length_m": path_length_m,
+        "long_approach_m": approach_distance,
+        "corner_turn_deg": corner_delta,
+        "turn_entry_speed_mps": turn_entry_speed,
+        "turn_min_speed_mps": turn_min_speed,
+        "turn_path_m": turn_path,
+        "corner_final_yaw_rate_radps": corner_final_rate,
+        "gate_crossed_during_crouch": gate_crossed,
+        "gate_crossing_speed_mps": gate_crossing_speed,
+        "gate_window_min_speed_mps": gate_window_min_speed,
+        "gate_crossing_trunk_z_m": gate_crossing_trunk_z,
+        "gate_crossing_head_pitch_rad": gate_crossing_head_pitch,
+        "gate_crossing_jaw_z_m": gate_crossing_jaw_z,
+        "crouch_progress_m": crouch_progress,
+        "recovered_after_gate": recovered_after_gate,
+        "spin_yaw_deg": spin_delta,
+        "spin_drift_m": spin_drift,
+        "spin_min_upright": spin_min_upright,
+        "final_planar_speed_mps": final_speed,
+        "complete_route_pass": route_pass,
+        "checks": {
+            "long_approach": approach_distance >= 1.0,
+            "carving_turn": 75.0 <= corner_delta <= 105.0
+            and turn_entry_speed >= 0.45
+            and turn_min_speed >= 0.20
+            and turn_path >= 0.30
+            and abs(corner_final_rate) <= 0.30,
+            "moving_crouch_gate": gate_crossed
+            and gate_crossing_speed >= 0.25
+            and gate_window_min_speed >= 0.20
+            and gate_crossing_trunk_z <= 0.10
+            and gate_crossing_jaw_z <= 0.19
+            and crouch_progress >= 0.30
+            and recovered_after_gate,
+            "spin": spin_pass,
+            "hard_stop": final_speed <= 0.06,
+        },
+        "video": None if args.no_video else str(args.video),
+        "metrics": str(args.metrics),
+    }
+    args.summary.parent.mkdir(parents=True, exist_ok=True)
+    args.summary.write_text(
+        json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+    )
+    print("\nAcceptance summary")
+    print(f"  displacement: {end_x - start_x:+.3f} m")
+    print(f"  route length: {path_length_m:.3f} m")
+    print(f"  long approach: {approach_distance:.3f} m")
+    print(f"  corner turn: {corner_delta:+.1f} deg")
+    print(f"  turn entry/min speed: {turn_entry_speed:.3f} / {turn_min_speed:.3f} m/s")
+    print(f"  turn curved path: {turn_path:.3f} m")
+    print(f"  corner final yaw rate: {corner_final_rate:+.3f} rad/s")
+    print(f"  crouch crossed gate: {'PASS' if gate_crossed else 'FAIL'}")
+    print(f"  speed at/around gate: {gate_crossing_speed:.3f} / {gate_window_min_speed:.3f} m/s")
+    print(
+        f"  trunk/jaw/head-pitch at gate: {gate_crossing_trunk_z:.3f} m / "
+        f"{gate_crossing_jaw_z:.3f} m / {gate_crossing_head_pitch:.3f} rad"
+    )
+    print(f"  crouch forward progress: {crouch_progress:.3f} m")
+    print(f"  recovered only after gate: {'PASS' if recovered_after_gate else 'FAIL'}")
+    print(f"  peak forward speed: {max_speed:+.3f} m/s")
+    print(f"  minimum trunk height: {min_z:.3f} m")
+    print(f"  minimum upright score: {min_upright:.3f} (1.0 is upright)")
+    print(f"  spin segment yaw: {spin_delta:+.1f} deg")
+    print(f"  spin drift: {spin_drift:.3f} m")
+    print(f"  spin minimum upright: {spin_min_upright:.3f}")
+    print(f"  spin final yaw rate: {spin_final_yaw_rate:+.3f} rad/s")
+    print(f"  spin acceptance: {'PASS' if spin_pass else 'FAIL'}")
+    print(f"  final planar speed: {final_speed:.3f} m/s")
+    print(f"  complete route acceptance: {'PASS' if route_pass else 'FAIL'}")
+    print(f"  metrics: {args.metrics}")
+    print(f"  summary: {args.summary}")
+    if not args.no_video:
+        print(f"  video: {args.video}")
+    if spin_session is None:
+        print("  NOTE: --spin not supplied; spin segment intentionally coasted and is not accepted.")
+
+
+if __name__ == "__main__":
+    main()
