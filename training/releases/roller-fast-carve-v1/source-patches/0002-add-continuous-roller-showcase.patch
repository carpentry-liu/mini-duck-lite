diff --git a/tests/test_showcase_timeline.py b/tests/test_showcase_timeline.py
new file mode 100644
index 0000000..c6e7ca3
--- /dev/null
+++ b/tests/test_showcase_timeline.py
@@ -0,0 +1,45 @@
+from mjlab_microduck.showcase import phase_at, smoothstep01, total_duration
+
+
+def test_showcase_timeline_has_no_boundary_gaps():
+    expected = (
+        (0.0, "settle"),
+        (0.8, "long_approach"),
+        (4.8, "carve_turn"),
+        (5.62, "corner_exit"),
+        (8.62, "crouch_gate"),
+        (12.12, "exit_gate"),
+        (13.12, "spin_360"),
+        (16.04, "hard_brake"),
+        (17.24, "head_tilt_finish"),
+        (19.48, "head_tilt_finish"),
+    )
+    assert tuple((time_s, phase_at(time_s).name) for time_s, _ in expected) == expected
+
+
+def test_showcase_duration_supports_a_readable_long_route():
+    assert total_duration() == 19.48
+
+
+def test_corner_turn_uses_calibrated_compressed_spin_cycle():
+    turn = phase_at(5.0)
+    assert turn.policy == "turn"
+    assert turn.cycle_period == 1.16
+    assert turn.action_blend_s == 0.08
+    assert turn.action_mix == 0.82
+
+
+def test_crouch_uses_the_period_seen_during_training():
+    crouch = phase_at(9.0)
+    assert crouch.policy == "crouch"
+    assert crouch.cycle_period == 5.0
+
+
+def test_smoothstep_clamps_and_eases_without_endpoint_velocity():
+    assert smoothstep01(-1.0) == 0.0
+    assert smoothstep01(0.0) == 0.0
+    assert smoothstep01(0.5) == 0.5
+    assert smoothstep01(1.0) == 1.0
+    assert smoothstep01(2.0) == 1.0
+    assert smoothstep01(0.1) < 0.1
+    assert smoothstep01(0.9) > 0.9
