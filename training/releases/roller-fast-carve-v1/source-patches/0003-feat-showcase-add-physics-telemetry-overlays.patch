+PREFERRED_JOINTS = (
+    "head_pitch",
+    "left_hip_pitch",
+    "left_knee",
+    "left_ankle",
+    "right_hip_pitch",
+    "right_knee",
+    "right_ankle",
+    "passive_LF_wheel",
+    "passive_RF_wheel",
+)
