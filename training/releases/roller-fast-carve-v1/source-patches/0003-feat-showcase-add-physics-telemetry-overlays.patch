+from pathlib import Path
+import sys
+
+import mujoco
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+from physics_overlay import log_arrow_length, select_representative_joints  # noqa: E402
+
+
+def test_log_arrow_length_is_monotonic_and_bounded():
+    lengths = [log_arrow_length(value) for value in (0.0, 0.1, 1.0, 10.0, 1_000.0)]
+    assert lengths == sorted(lengths)
+    assert lengths[0] >= 0.025
+    assert lengths[-1] <= 0.24
+
+
+def test_representative_joint_selection_covers_head_legs_and_wheels():
+    scene = ROOT / "src/mjlab_microduck/robot/microduck/scene_roller_showcase.xml"
+    model = mujoco.MjModel.from_xml_path(str(scene))
+    selected = select_representative_joints(model)
