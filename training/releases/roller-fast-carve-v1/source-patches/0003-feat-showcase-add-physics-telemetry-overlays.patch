+FORCE_COLORS = ((86, 192, 255), (68, 231, 166), (255, 111, 145))
+TORQUE_COLORS = ((255, 185, 75), (179, 125, 255), (255, 91, 74))
+BG = (7, 15, 27)
+PANEL = (13, 26, 43)
+GRID = (43, 61, 80)
+TEXT = (226, 235, 244)
+MUTED = (135, 154, 175)
+ACCENT = (255, 174, 69)
