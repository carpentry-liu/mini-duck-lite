diff --git a/tests/test_joint_wrench.py b/tests/test_joint_wrench.py
new file mode 100644
--- /dev/null
+++ b/tests/test_joint_wrench.py
@@ -0,0 +1,46 @@
+"""Joint wrench reference frames agree with MuJoCo's own site sensors."""
+
+import importlib.util
+import json
+from pathlib import Path
+
+import mujoco
+import numpy as np
+import pytest
+
+
+MODULE_PATH = Path(__file__).resolve().parents[1] / "scripts/physics_overlay.py"
+SPEC = importlib.util.spec_from_file_location("physics_overlay", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+@pytest.mark.parametrize("yaw", [0, 90])
+def test_joint_wrench_matches_sensor_at_anchor_in_world_axes(yaw, tmp_path):
+    model = mujoco.MjModel.from_xml_string(f'''<mujoco><worldbody>
+      <body name="dummy" pos="3 0 1"><freejoint name="trunk_base_freejoint"/>
+        <geom type="sphere" size="0.1" mass="1"/></body>
+      <body name="beam" pos="0 0 1" euler="0 0 {yaw}">
+        <joint name="left_knee" type="hinge" axis="1 0 0"/>
+        <geom type="box" pos="0.5 0 0" size="0.5 0.05 0.05" mass="1"/>
+        <site name="joint_sensor" pos="0 0 0" size="0.01"/>
+      </body>
+    </worldbody><sensor><force site="joint_sensor"/>
+      <torque site="joint_sensor"/></sensor></mujoco>''')
+    data = mujoco.MjData(model)
+    mujoco.mj_forward(model, data)
+    recorder = MODULE.PhysicsRecorder(model, data, 50.0)
+    values = recorder.capture(0.0, "static")["joints"]["left_knee"]
+    site = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_SITE, "joint_sensor")
+    rotation = data.site_xmat[site].reshape(3, 3)
+    np.testing.assert_allclose(values["force_n"], rotation @ data.sensordata[:3], atol=1e-12)
+    np.testing.assert_allclose(values["torque_nm"], rotation @ data.sensordata[3:6], atol=1e-12)
+    assert np.linalg.norm(values["torque_nm"]) == pytest.approx(4.905)
+    np.testing.assert_allclose(values["wrench_origin_m"], data.site_xpos[site])
+    assert values["wrench_axes"] == "world"
+    recorder.write(tmp_path / "telemetry.json", tmp_path / "telemetry.csv")
+    payload = json.loads((tmp_path / "telemetry.json").read_text())
+    assert payload["wrench_origin"] == "joint_anchor"
+    assert payload["wrench_axes"] == "world"
+    assert "joint.left_knee.wrench_origin_x_m" in (tmp_path / "telemetry.csv").read_text()
